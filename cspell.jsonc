{
  "version": "0.2",

  // American English only. Accepting both dialects would let the two mix indefinitely, since a spell
  // checker can reject a word but cannot tell which side of the Atlantic a document meant to be on.
  // Dropping en-GB makes that a gate failure instead of a silent inconsistency.
  //
  // A British spelling will therefore be reported as unknown. It is a spelling to change, not a word
  // to add to `project-words.txt`: adding them one at a time would rebuild the dictionary that was just
  // removed, and badly.
  "language": "en",

  // Kept to the minimum that makes the repository clean. "npm" and "rust" are here because both
  // domains have thousands of identifiers no prose dictionary carries, not because one word was
  // inconvenient.
  "dictionaries": ["rust", "npm", "project-words"],
  "dictionaryDefinitions": [{ "name": "project-words", "path": "./project-words.txt" }],

  "useGitignore": true,
  "ignorePaths": [
    // Generated by npm; full of hashes and package names.
    "package-lock.json",
    // The dictionary itself: spell checking a list of deliberately unusual words is circular.
    "project-words.txt",
    // Generated by the build. A binary, and full of register names from the target's standard
    // library.
    "target/**",
  ],

  // Rust string literals contain escape sequences, and without this cspell reads the "\n" at the
  // start of "\nxtask" as part of the word that follows it.
  //
  // The directive below is needed because this comment spells the false positive out, and without it
  // this file reports the very problem it is describing.
  // cspell:ignore xtask
  "ignoreRegExpList": ["EscapeCharacters"],
}
