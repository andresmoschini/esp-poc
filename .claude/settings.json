{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git config core.hooksPath .claude/git-hooks",
            "shell": "bash",
            "timeout": 5,
            "statusMessage": "Installing git hooks..."
          }
        ]
      }
    ]
  }
}
